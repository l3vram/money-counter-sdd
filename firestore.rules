service cloud.firestore {
  // Root of Firestore rules
  match /databases/{database}/documents {

    // Default: deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: each user can read their own document
    match /users/{uid} {
      // Read only by the authenticated owner
      allow read: if request.auth != null && request.auth.uid == uid;

      // Create allowed only for the owner and must start with access = 'PENDING'
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.access == 'PENDING';

      // Update allowed only for the owner and access field cannot change
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.access == resource.data.access;

      // Delete is not allowed (no rule, inherits default deny)
    }

    // All subcollections of a user (e.g., products, denominations, etc.)
    match /users/{uid}/{sub=**} {
      // Read and write only by the authenticated owner
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}